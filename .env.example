# ==============================
# ASAAS — Gateway de Pagamentos
# ==============================
# Obtenha sua chave em: https://sandbox.asaas.com (Minha Conta → Integrações → API)

# Chave de API da conta PARCEIRA (plataforma)
ASAAS_API_KEY=sandbox_sua_chave_aqui

# Ambiente: SANDBOX (testes) ou PRODUCTION (real)
ASAAS_ENVIRONMENT=SANDBOX

# ==============================
# Base ERP — Nota Fiscal de Produto (NF-e/NFC-e)
# ==============================
# API própria do Base ERP (integrado à mesma conta Asaas, mas com autenticação e
# base URL separadas). Gere o access_token pelo próprio painel do Base ERP —
# a configuração fiscal (regime tributário, certificado A1/A3, grupo de impostos)
# é feita manualmente lá, não tem endpoint de API para isso.
BASEERP_API_KEY=sua_chave_aqui

# Ambiente: SANDBOX (homologação) ou PRODUCTION (real)
BASEERP_ENVIRONMENT=SANDBOX
